# 示例文件：不要填写真实密码后提交 Git。
# 服务器部署时复制为 /opt/family-nutrition-state/.env，并只在服务器上填写真实值。

FAMILY_NUTRITION_POSTGRES_DB=family_nutrition

# owner/bootstrap 用户：用于初始化数据库和执行 migration。
FAMILY_NUTRITION_POSTGRES_OWNER_USER=family_nutrition_owner
FAMILY_NUTRITION_POSTGRES_OWNER_PASSWORD=change-me-owner-password

# app/runtime 用户：用于后续 MCP 服务运行时访问。
# Milestone 1 先预留；Milestone 2 会正式创建最小权限 runtime role。
FAMILY_NUTRITION_POSTGRES_APP_USER=family_nutrition_app
FAMILY_NUTRITION_POSTGRES_APP_PASSWORD=change-me-app-password

# 示例连接串只保留变量名；真实连接串只在服务器 .env 中填写。
FAMILY_NUTRITION_MIGRATION_DATABASE_URL=set-on-server-only
FAMILY_NUTRITION_DATABASE_URL=set-on-server-only

# MCP 服务鉴权 token。Milestone 0/2 使用；真实值只放服务器 .env。
FAMILY_NUTRITION_MCP_AUTH_TOKEN=change-me-token
